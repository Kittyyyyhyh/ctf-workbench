#!/usr/bin/env bash
# ctf-workbench CLI wrapper for Git Bash / Linux.
# Canonical entry: python -m ctfcli  (this wrapper just saves some typing).
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${PYTHON:-python}"
command -v "$PY" >/dev/null 2>&1 || PY=python3
exec "$PY" "$DIR/ctfcli/cli.py" "$@"
